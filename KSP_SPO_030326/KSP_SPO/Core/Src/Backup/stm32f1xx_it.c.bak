/**
  * @brief This function handles TIM1 update interrupt.
  */
void TIM1_UP_IRQHandler(void)
{
  /* USER CODE BEGIN TIM1_UP_IRQn 0 */

		if (++tick%1000 == 0){
        if(!isOrigin) {
            LL_GPIO_TogglePin(ledKeyAbsoluteOriginSet.port, ledKeyAbsoluteOriginSet.pin);
        }
        if(motor.status == RUNNING) {
            LL_GPIO_TogglePin(ledKeySpindleStop.port, ledKeySpindleStop.pin);
        }
        if(motor.status == STOPPED) {
            LL_GPIO_TogglePin(ledKeySpindleStart.port, ledKeySpindleStart.pin);
        }
        if(rpmChange){
            rpmEdit = !rpmEdit;
        }
        if(absChange){
            absEdit = !absEdit;
        }
        if(incChange){
            incEdit = !incEdit;
        }
		//LL_GPIO_TogglePin(LED_GPIO_Port, LED_Pin);
	}
  /* USER CODE END TIM1_UP_IRQn 0 */
  /* USER CODE BEGIN TIM1_UP_IRQn 1 */

  /* USER CODE END TIM1_UP_IRQn 1 */
}

