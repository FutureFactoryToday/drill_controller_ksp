uint8_t tx_buf[256*64/2];

uint32_t cntLine = 0;

bool isOrigin = false;

bool rpmChange = true;
bool absChange = false;
bool incChange = false;

bool rpmEdit = false;
bool absEdit = false;
bool incEdit = false;
