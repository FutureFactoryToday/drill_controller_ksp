--cpu Cortex-M3
"cm15\main.o"
"cm15\gpio.o"
"cm15\spi.o"
"cm15\tim.o"
"cm15\stm32f1xx_it.o"
"cm15\stm32f1xx_ll_gpio.o"
"cm15\stm32f1xx_ll_spi.o"
"cm15\stm32f1xx_ll_dma.o"
"cm15\stm32f1xx_ll_rcc.o"
"cm15\stm32f1xx_ll_utils.o"
"cm15\stm32f1xx_ll_exti.o"
"cm15\stm32f1xx_ll_pwr.o"
"cm15\stm32f1xx_ll_tim.o"
"cm15\startup_stm32f10x_hd.o"
"cm15\system_stm32f1xx.o"
"cm15\st7565.o"
"cm15\fonts.o"
"cm15\ssd1322_api.o"
"cm15\ssd1322_gfx.o"
"cm15\ssd1322_hw_driver.o"
"cm15\bitmap.o"
"cm15\layout.o"
"cm15\mainframe.o"
"cm15\items.o"
"cm15\eventcontroller.o"
"cm15\widgets.o"
"cm15\spfunc.o"
"cm15\coef.o"
"cm15\timer.o"
--strict --scatter "CM15\CM15.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "./CM15/\CM15.map" -o CM15\CM15.axf